hwLayout hbModeMenu {
    PosX = 0  PosY = 0
    Width = 0  Height = 0
    Align = (HW_GUI_REL_WIDTH + HW_GUI_REL_HEIGHT)
    Children = {
        hwLabel {
            PosX = 500  PosY = 25
            Width = 1000 Height = 50
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Label = "Mode Menu"
        },
        hwRowCol {
            Rows = 5  Columns = 1
            PosX = 500  PosY = 525
            Width = 333  Height = 950
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Padding = {20,20}
            Children = {
                hwToggle hbWireframe {
                    ID = 500
                    Label = "Wireframe"
                    Exclude = { hwToggle hbSolid {}, hwToggle hbTextured {} }
                    BackgroundColor = {.5,.5,.5}
                },
                hwToggle hbSolid {
                    ID = 510
                    Label = "Solid"
                    Exclude = { hbWireframe, hbTextured }
                    BackgroundColor = {.5,.5,.5}
                },
                hwToggle hbTextured {
                    ID = 520
                    Label = "Textured"
                    Exclude = { hbWireframe, hbSolid }
                    BackgroundColor = {.5,.5,.5}
                },
                hwButton {
                    ID = 1000
                    Label = "Back"
                    BackgroundColor = {.5,.5,.5}
                }
            }
        }
    }
    FontHeight = 24
    ActiveColor = {0,0,0}
    ActiveBackground = {1,1,1}
}

hwLayout hbDetailMenu {
    PosX = 0  PosY = 0
    Width = 0  Height = 0
    Align = (HW_GUI_REL_WIDTH + HW_GUI_REL_HEIGHT)
    Children = {
        hwLabel {
            PosX = 500  PosY = 25
            Width = 1000 Height = 50
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Label = "Detail Menu"
        },
        hwRowCol {
            Rows = 5  Columns = 1
            PosX = 500  PosY = 525
            Width = 333  Height = 950
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Padding = {20,20}
            Children = {
                hwToggle hbLowRes {
                    ID = 600
                    Label = "Low"
                    Exclude = { hwToggle hbMedRes {}, hwToggle hbHiRes {},
                                hwToggle hbExtRes {} }
                    BackgroundColor = {.5,.5,.5}
                },
                hwToggle hbMedRes {
                    ID = 610
                    Label = "Medium"
                    Exclude = { hbLowRes, hbHiRes, hbExtRes }
                    BackgroundColor = {.5,.5,.5}
                },
                hwToggle hbHiRes {
                    ID = 620
                    Label = "High"
                    Exclude = { hbLowRes, hbMedRes, hbExtRes }
                    BackgroundColor = {.5,.5,.5}
                },
                hwToggle hbExtRes {
                    ID = 630
                    Label = "Extreme"
                    Exclude = { hbLowRes, hbMedRes, hbHiRes }
                    BackgroundColor = {.5,.5,.5}
                },
                hwButton {
                    ID = 1000
                    Label = "Back"
                    BackgroundColor = {.5,.5,.5}
                }
            }
        }
    }
    FontHeight = 24
    ActiveColor = {0,0,0}
    ActiveBackground = {1,1,1}
}

