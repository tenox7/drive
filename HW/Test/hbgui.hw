hwLayout hbMainMenu {
    PosX = 0  PosY = 0
    Width = 0  Height = 0
    Align = (HW_GUI_REL_WIDTH + HW_GUI_REL_HEIGHT)
    Children = {
        hwLabel {
            PosX = 500  PosY = 25
            Width = 1000 Height = 50
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Label = "Main Menu"
        },
        hwRowCol {
            PosX = 500  PosY = 525
            Width = 333  Height = 950
            Align = (HW_GUI_FRACTIONAL + HW_GUI_CENTER)
            Padding = {20,20}
            Rows = 5  Columns = 1
            Children = {
                hwButton {
                    ID = 100
                    Label = "Game"
                    BackgroundColor = {.5,.5,.5}
                },
                hwButton {
                    ID = 110
                    Label = "Options"
                    BackgroundColor = {.5,.5,.5}
                },
                hwButton {
                    ID = 120
                    Label = "About"
                    BackgroundColor = {.5,.5,.5}
                },
                hwButton {
                    ID = 1000
                    Label = "Back"
                    BackgroundColor = {.5,.5,.5}
                }
            }
        }
    }
    FontHeight = 24
    ActiveColor = {0,0,0}
    ActiveBackground = {1,1,1}
}

