hwEnviron {
    BackgroundColor = {0,0,0}
    AmbientFactor = 1.0
    AmbientColor = {0.4, 0.4, 0.4}
}

hwCamera {
    Pos = {0,0,-1}
    Dir = {0,0,1}
    Up = {0,1,0}
    Perspective = True
    Planes = {0.1, 100}
    Field = 75
}

hwTimer {
    Equation = {0,1}
    CycleTime = 1
    Children = { hwSpinner {
        Lifetime = {0,0.8}
        PosType = HW_SPIN_RANDOM
        PosParams = {-0.5, -0.5, 0.0,   0.5, 0.5, 0.0}
        ColorType = HW_SPIN_RANDOM
        ColorParams = {.5,.5,.5,  1,1,1}
        Children = { hwText {
            Surface = {
                hwSurface { Color = {1,0,0} },
                hwSurface { Invisible = True },
                hwSurface { Invisible = True }
            }
            Scale = 0.1
            Data = "Random"
        } }
    } }
}
