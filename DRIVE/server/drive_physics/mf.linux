TARGET=physics.a

include ../../mf.linux.h

LIBPRIMS=../../libprims
LIBPHYSICS=../../libphysics
LIBNUM=../../libnum
INC=../../include
INCLUDES=\
  -I$(INC) \
  -I$(LIBPHYSICS) \
  -I$(LIBNUM) \
  -I$(LIBPRIMS) \
  -I../objects \
  -I/opt/HoverWare/Inc

# Standard rules to turn all the *.c files to $(OBJ)*.o files
SRC := $(wildcard *.c)
OFILES := $(SRC:%.c=$(OBJ)%.o)
$(OFILES): $(OBJ)%.o : %.c
	@ mkdir -p $(@D)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): $(OFILES)
	ar rv $@ $?

