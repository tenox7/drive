# Flasher construct
#
# The flasher is a round object centered at 0,0,bottom.
#
#
# Daryl Poe


# The stand
Object: cylinder
Radius: 1.0
Height: 0.5
Color: 0.5 0.5 0.5

Object: cylinder
Radius: 0.2
Height: 2.5
Y: 0.5
Color: 0.5 0.5 0.5


# Flashing light
Object: wall
Width: 1.0
Length: 1.0
Height: 1.0
Y: 3.0
Z: -0.5
Color: 0.2 0.0 0.0

Object: light
Width: 1.0
Length: 1.0
Y: 3.5
Z: -0.5
Xrot: -90
Color: 1.0 0.0 0.0
Animation Bits: 0x5555

Object: light
Width: 1.0
Length: 1.0
Y: 3.5
Z: 0.5
Xrot: 90
Color: 1.0 0.0 0.0
Animation Bits: 0x5555

Object: light
Width: 1.0
Length: 1.0
Y: 3.5
X: 0.5
Zrot: -90
Color: 1.0 0.0 0.0
Animation Bits: 0xaaaa

Object: light
Width: 1.0
Length: 1.0
Y: 3.5
X: -0.5
Zrot: 90
Color: 1.0 0.0 0.0
Animation Bits: 0xaaaa


